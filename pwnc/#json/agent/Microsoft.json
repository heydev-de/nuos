{
    "version": 1,

    "url": "%endpoint%/openai/deployments/%model%/chat/completions?api-version=%api_version%",

    "header": {
        "content-type": "application/json",
        "api-key": "%api_key%"
    },

    "request": {
        "[max_tokens]": "%max_tokens%",
        "[temperature]": "%temperature%",
        "messages": "%message%",
        "[tools]": "%tool%"
    },

    "user": {
        "role": "user",
        "content": "%text%"
    },

    "assistant": "%reply%",

    "tool": {
        "type": "function",
        "function": {
            "name": "%name%",
            "description": "%description%",
            "parameters": "%schema%"
        }
    },

    "value": {
        "reason": "choices/0/finish_reason",
        "reply": "choices/0/message",
        "call": "choices/0/message/tool_calls",
        "error": "error/message"
    },

    "action": {
        "stop": "stop",
        "content_filter": "stop",
        "length": "resume",
        "tool_calls": "tool"
    },

    "call": {
        "id": "id",
        "name": "function/name",
        "argument": "function/arguments"
    },

    "result": {
        "block": {
            "role": "tool",
            "tool_call_id": "%id%",
            "content": "%content%"
        }
    },

    "system": {
        "role": "system",
        "content": "%system%"
    },

    "default": {
        "api_version": "2024-10-21",
        "max_tokens": 16384
    },

    "required": [
        "endpoint",
        "model",
        "api_key"
    ],

    "prefill": false,
    "overflow": "/context length|maximum context|too long|reduce the length/i"
}
